---
import "../styles/global.css";
import Fonts from "../components/Fonts.astro";
import DotGrid from "../components/DotGrid.astro";
import PostIt from "../components/PostIt.astro";
import HighlightSelection from "../components/HighlightSelection.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>!localhost (SMI 2026)</title>
        <Fonts />
    </head>
    <body>
        <DotGrid>
            <div class="flex h-full flex-col items-center justify-center gap-8 sm:flex-row sm:gap-12">
                <PostIt rotate={-6}>
                    <h1>Sticky note</h1>
                    <ul>
                        <li>Typical colour</li>
                    </ul>
                </PostIt>
                <PostIt color="blue" rotate={4}>
                    <h1>Another sticky note</h1>
                    <ul>
                        <li>But, in blue</li>
                    </ul>
                </PostIt>
            </div>
        </DotGrid>
        <HighlightSelection />
    </body>
</html>
