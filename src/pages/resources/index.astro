---
import SiteShell from "../../components/SiteShell.astro";
import { getResources } from "../../lib/resources";

const resources = await getResources();
---

<SiteShell title="Resources">
            <div class="mx-auto max-w-2xl py-16">
                <h1 class="font-heading text-5xl">
                    Resources
                </h1>
                <p class="mt-1 text-base text-gray-600">
                    Guides and references for the course.
                </p>

                <ul class="mt-12 space-y-4 text-gray-800">
                    {
                        resources.map(({ entry, title }) => (
                            <li>
                                <a
                                    class="underline underline-offset-2 hover:no-underline"
                                    href={`/resources/${entry.id}`}
                                >
                                    {title}
                                </a>
                                {entry.data.description && (
                                    <p class="text-sm text-gray-600">
                                        {entry.data.description}
                                    </p>
                                )}
                            </li>
                        ))
                    }
                </ul>
            </div>
</SiteShell>
